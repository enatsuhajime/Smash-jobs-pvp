+#実行者：死亡したプレイヤー
+scoreboard players set @s GuDeath 0
+execute if entity @s[tag=Guerrilla] run function main:pvp/guerrilla/death/self
+execute unless score @s GuAssist matches 1.. run return 0
+scoreboard players set @s GuAssist 0
